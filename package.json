{
  "name": "zero-incident",
  "version": "1.3.0",
  "private": true,
  "description": "Zero Incident \u2014 secure onboarding, Manual Handling and Working at Height",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test --test-concurrency=1 tests/integration.test.js",
    "test:browser": "node tests/browser-smoke.mjs",
    "admin:recover": "node --env-file-if-exists=.env server/recover-admin.js",
    "format": "prettier --write \"server/*.js\" \"public/js/*.js\" public/styles.css public/training.css public/index.html \"tests/*.{js,mjs}\"",
    "test:appearance": "node tests/appearance-smoke.mjs",
    "test:manual": "node --test tests/manual-handling.test.js",
    "test:manual:browser": "node tests/manual-browser.mjs",
    "test:height": "node --test tests/working-at-height.test.js",
    "test:height:browser": "node tests/height-browser.mjs"
  },
  "dependencies": {
    "connect-mongo": "^5.1.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.1.0",
    "mongodb-memory-server": "^10.2.0",
    "mongoose": "^8.16.0",
    "multer": "^2.0.2",
    "sharp": "^0.35.4",
    "three": "^0.185.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@playwright/test": "^1.55.0",
    "prettier": "^3.9.6",
    "supertest": "^7.1.0"
  }
}
